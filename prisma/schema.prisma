datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("CUSTOMER") // CUSTOMER, SELLER, ADMIN
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  sellerProfile Seller?
  cartItems    CartItem[]
  wishlistItems WishlistItem[]
  orders       Order[]
  reviews      Review[]
  returns      ReturnRequest[]
  events       UserEvent[]
  stylistSessions AIStylistSession[]
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime   @default(now())
}

model Seller {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName        String
  storeDescription String?
  rating           Float        @default(4.5)
  isApproved       Boolean      @default(true)
  logoUrl          String?
  products         Product[]
  orderItems       OrderItem[]
  createdAt        DateTime     @default(now())
}

model Product {
  id              String           @id @default(uuid())
  sellerId        String
  seller          Seller           @relation(fields: [sellerId], references: [id])
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  name            String
  slug            String           @unique
  brand           String
  description     String
  specifications  String           @default("{}") // JSON string of attributes
  price           Float
  discountPercent Float            @default(0)
  isApproved      Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  tags            String           @default("") // comma separated tags
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images          ProductImage[]
  variants        ProductVariant[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  events          UserEvent[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  sku       String   @unique
  price     Float
  stock     Int      @default(10)
  imageUrl  String?

  cartItems CartItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
}

model CartItem {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())

  @@unique([userId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Float
  maxDiscount     Float    @default(1000)
  minSpend        Float    @default(500)
  expiresAt       DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  subtotal        Float
  discountAmount  Float    @default(0)
  shippingFee     Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float
  couponCode      String?
  paymentMethod   String   // UPI, CARD, NETBANKING, COD
  paymentStatus   String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  orderStatus     String   @default("PLACED") // PLACED, CONFIRMED, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURNED
  shippingAddress String   // JSON string of address
  trackingNumber  String?
  courierName     String?  @default("StyleKart Express")
  estimatedDelivery String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
  history         OrderStatusHistory[]
  payments        PaymentTransaction[]
  returns         ReturnRequest[]
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sellerId  String
  seller    Seller          @relation(fields: [sellerId], references: [id])
  quantity  Int
  unitPrice Float
  status    String          @default("PLACED")
  createdAt DateTime        @default(now())
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model PaymentTransaction {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String   @default("RAZORPAY_SANDBOX")
  transactionId  String   @unique
  orderIdGateway String?
  signature      String?
  amount         Float
  status         String   // PENDING, SUCCESS, FAILED, REFUNDED
  rawData        String?  // JSON string
  createdAt      DateTime @default(now())
}

model Review {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating             Int
  title              String
  comment            String
  images             String   @default("[]") // JSON string of image URLs
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model ReturnRequest {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  comments  String?
  status    String   @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, PICKUP_SCHEDULED, RETURNED, REFUND_INITIATED, REFUNDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventType String   // VIEW, SEARCH, CART, WISHLIST, PURCHASE
  metadata  String   @default("{}") // JSON string
  createdAt DateTime @default(now())
}

model AIStylistSession {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  occasion        String
  style           String
  budget          Float
  preferences     String   @default("{}") // JSON string
  recommendations String   @default("[]") // JSON string of product IDs
  createdAt       DateTime @default(now())
}
